# DEADZONE agent — copy to .env and fill in. (.env is gitignored.)

# --- LLM brain (tiered: tries in LLM_ORDER, then deterministic fallback) ---
ZAI_API_KEY=            # Z.ai GLM (primary). Get one at https://z.ai/manage-apikey/apikey-list
ANTHROPIC_API_KEY=      # Anthropic Claude (secondary fallback)
LLM_ORDER=glm,anthropic # resolution order before deterministic fallback
GLM_MODEL=glm-4.5-flash # free, fast; glm-4-flash is retired
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_RETRIES=1           # retries per provider before falling through
# DEADZONE_DEBUG=1       # log provider attempts/errors

# --- Mantle (the deployer key lives in contracts/.env, not here) ---
MANTLE_SEPOLIA_RPC=https://rpc.sepolia.mantle.xyz
