# Deadzone gateway — copy to .env and fill in. (.env is gitignored.)
# Secrets are also read from ../agent/.env (LLM keys) and ../contracts/.env (PRIVATE_KEY).

PORT=8787
COURIER_AGENT_ID=1          # reuse an existing ERC-8004 identity instead of minting a new one

# safety caps (the gateway holds the courier key + pays gas)
MAX_PAY_AMOUNT=1000         # max dUSD per settlement
FAUCET_AMOUNT=1000          # fixed dUSD per faucet grant
FAUCET_COOLDOWN_MS=300000   # 5 min per address
RATE_WINDOW_MS=60000        # rate-limit window
RATE_MAX=20                 # max POSTs per window per IP

# required (from ../contracts/.env): PRIVATE_KEY=0x...
# optional (from ../agent/.env): ZAI_API_KEY=... ANTHROPIC_API_KEY=...
