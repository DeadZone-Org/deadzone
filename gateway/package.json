{
  "name": "@deadzone/gateway",
  "version": "0.1.0",
  "type": "module",
  "description": "Deadzone online gateway — runs the autonomous Settlement Agent and exposes it over HTTP for the web dApp.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=../agent/.env --env-file-if-exists=../contracts/.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=../agent/.env --env-file-if-exists=../contracts/.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "ethers": "^6.16.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
